{
  "name": "teach-me-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/host/main.cjs",
  "bin": {
    "teach-me-agent": "bin/teach-me.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20",
      "sass": "1.105.2",
      "@radix-ui/react-tabs": "1.2.1"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1",
    "katex": "0.18.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-host.mjs",
    "app": "npm run build && node scripts/launch.mjs",
    "test": "node --test test/*.test.cjs test/*.test.ts",
    "plan": "node scripts/check-plan.cjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "format": "prettier --write src bin scripts test package.json tsconfig.json vite.config.ts",
    "format:check": "prettier --check src bin scripts test package.json tsconfig.json vite.config.ts",
    "boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run plan && npm run boundaries && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
